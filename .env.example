# SERAPHI GAME — Environment Variables
# Copy this file to .env for local configuration or set these in Koyeb Environment Variables.
# DO NOT commit real secrets or credentials to source control.

# 1. Database Configuration (Target: Neon Free PostgreSQL for Production, SQLite for Local)
# Set DATABASE_PROVIDER=postgres for Neon / Koyeb deployment
# Set DATABASE_PROVIDER=sqlite for offline local development
DATABASE_PROVIDER=postgres
DATABASE_URL=

# 2. Content & Mode Isolation
# CONTENT_MODE: 'production' enforces zero demo items across public listings
CONTENT_MODE=production

# 3. Search Engine Indexing Switch (SEO Safety)
# Set to 'false' during staging / test deployments on Koyeb temporary domain
# Set to 'true' only when mapped to official production custom domain
INDEXING_ENABLED=false

# 4. Public Site Domain
# Set to your Koyeb generated URL or custom domain (e.g. https://seraphi-game-yourname.koyeb.app)
NEXT_PUBLIC_SITE_URL=https://seraphi-game-staging.koyeb.app

# 5. Admin Authentication & Session Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# 6. Optional Telemetry & Monetization
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_AD_PROVIDER=none

# 7. AI Content Publisher Security
# Secret token for external AI agent to publish content directly to Neon PostgreSQL
AI_CONTENT_PUBLISH_TOKEN=
